---
import type { KeepsakePageModel } from '../storefront/models';

/**
 * The Keepsake Items page (`/`).
 *
 * A minimal storefront listing: every active product as a stacked section on
 * one page, in position order. No cart, no buy-now, no category breadcrumb —
 * and no pick buttons: since the flex-menu dialog (2026-11-14) this page is
 * VIEW-ONLY reference. The numbered items match the dialog's flex menu; the
 * pick itself is a tap in the Muse dialog, never a click here. Nothing here
 * posts to /api/cart or navigates to checkout.
 *
 * The model arrives fully resolved (see features/storefront/keepsakes.ts);
 * the template decides only how it looks.
 */
interface Props {
  model: KeepsakePageModel;
}

const { model } = Astro.props;
const items = model.items;
const showJumpNav = items.length > 1;
---

<div class="mb-10">
  <h1 class="font-serif text-4xl tracking-tight sm:text-5xl">{model.heading}</h1>
  <p class="mt-3 max-w-prose text-muted">
    View only — look here, then tap your pick in the Muse dialog
  </p>
</div>

{
  showJumpNav && (
    <nav
      aria-label="Keepsake items"
      class="sticky top-[72px] z-10 mb-10 border-b border-line bg-paper/90 py-3 backdrop-blur sm:top-20"
    >
      <ul class="flex flex-wrap gap-2">
        {items.map((item) => (
          <li>
            <a
              href={`#keepsake-${item.position}`}
              class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-[#fa6001] text-sm font-semibold tabular-nums text-white transition hover:opacity-90"
            >
              {item.position}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

{
  items.length === 0 && (
    <p role="status" class="text-muted">
      No products yet.
    </p>
  )
}

{
  items.map((item) => {
    const hero = item.gallery[0]!;
    return (
      <section
        id={`keepsake-${item.position}`}
        data-keepsake
        data-index={item.position}
        class="mb-16 scroll-mt-40 border-b border-line pb-16 last:mb-0 last:border-b-0 last:pb-0"
      >
        <div class="grid gap-8 md:grid-cols-2 md:gap-12">
          <div>
            <div class="overflow-hidden rounded-md bg-surface">
              <img
                data-gallery-main
                src={hero.src}
                srcset={hero.srcset}
                sizes={hero.sizes}
                alt={hero.alt}
                class="aspect-square w-full object-cover"
                width="600"
                height="600"
                loading={item.position === 1 ? 'eager' : 'lazy'}
                fetchpriority={item.position === 1 ? 'high' : 'auto'}
                decoding="async"
                data-image-fade={item.position === 1 ? undefined : ''}
              />
            </div>
            {item.gallery.length > 1 && (
              <div class="mt-3 flex flex-wrap gap-2">
                {item.gallery.map((g, gi) => (
                  <button
                    type="button"
                    data-gallery-thumb
                    data-src={g.src}
                    data-srcset={g.srcset ?? ''}
                    data-alt={g.alt}
                    aria-label={`View image ${gi + 1} of ${item.gallery.length}`}
                    aria-pressed={gi === 0 ? 'true' : 'false'}
                    class="keepsake-thumb overflow-hidden rounded-md ring-1 ring-line transition hover:ring-brand"
                  >
                    <img src={g.src} alt="" class="h-16 w-16 object-cover" loading="lazy" decoding="async" />
                  </button>
                ))}
              </div>
            )}
          </div>

          <div>
            {item.brand && (
              <p class="text-xs uppercase tracking-widest text-faint">{item.brand}</p>
            )}
            <h2 class="mt-2 font-serif text-3xl tracking-tight">{item.name}</h2>

            {item.rating !== null && item.reviewCount !== null && (
              <p class="mt-3 flex flex-wrap items-center gap-2 text-sm text-muted">
                <span
                  class="relative inline-block leading-none"
                  role="img"
                  aria-label={`Rated ${item.rating} out of 5`}
                >
                  <span class="text-faint">★★★★★</span>
                  <span
                    class="absolute left-0 top-0 overflow-hidden whitespace-nowrap text-amber-600"
                    style={`width:${(item.rating / 5) * 100}%`}
                  >
                    ★★★★★
                  </span>
                </span>
                <span class="tabular-nums">
                  {item.rating} · {item.reviewCount} reviews
                </span>
              </p>
            )}

            <p class="mt-3 text-2xl tabular-nums text-muted">
              {item.priceVaries && <span class="text-base text-faint">from </span>}
              {item.formattedPrice}
            </p>
            <p class={`mt-2 text-sm ${item.inStock ? 'text-muted' : 'text-amber-700'}`}>
              {item.inStock ? 'In stock' : 'Out of stock'}
            </p>

            {item.descriptionHtml && (
              <div
                class="markdown-content mt-4 max-w-prose text-muted"
                set:html={item.descriptionHtml}
              />
            )}

            {item.variants.length > 0 && item.variantLabel && (
              <div class="mt-6">
                <p class="text-xs uppercase tracking-widest text-faint">
                  {item.variantLabel}
                </p>
                <div class="mt-2 flex flex-wrap gap-2">
                  {item.variants.map((v) => (
                    <span class="rounded-md border border-line px-4 py-2 text-sm">
                      {v.label}
                    </span>
                  ))}
                </div>
              </div>
            )}

            <p class="mt-6 text-sm text-muted">
              To pick this one, tap {item.position} in your Muse dialog.
            </p>

            {item.features.length > 0 && (
              <div class="mt-8">
                <h3 class="text-xs uppercase tracking-widest text-faint">About this item</h3>
                <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-muted">
                  {item.features.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
              </div>
            )}

            {item.reviewInsights.length > 0 && (
              <div class="mt-8">
                <h3 class="text-xs uppercase tracking-widest text-faint">Customers say</h3>
                <ul class="mt-3 space-y-3">
                  {item.reviewInsights.map((ri) => (
                    <li>
                      <p class="text-sm font-medium capitalize">
                        {ri.label} · {ri.mentionPercent}%
                      </p>
                      <p class="mt-0.5 text-sm text-muted">{ri.summary}</p>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {item.ratingBreakdown.length > 0 && (
              <div class="mt-8">
                <h3 class="text-xs uppercase tracking-widest text-faint">Ratings</h3>
                <ul class="mt-3 space-y-1 text-sm text-muted">
                  {item.ratingBreakdown.map((b) => (
                    <li class="flex items-center gap-2">
                      <span class="w-6 tabular-nums">{b.stars}★</span>
                      <span class="h-2 flex-1 overflow-hidden rounded bg-surface">
                        <span
                          class="block h-2 rounded bg-brand"
                          style={`width:${b.percent}%`}
                        />
                      </span>
                      <span class="w-10 text-right tabular-nums">{b.percent}%</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      </section>
    );
  })
}

<style>
  /* Selected gallery thumbnail: the store's brand color is a theme token,
     so read it as a variable (with the shipped value as the fallback)
     rather than hardcoding the hex. */
  .keepsake-thumb[aria-pressed='true'] {
    border-color: var(--color-brand, #111827);
    color: var(--color-brand, #111827);
  }
</style>

<script>
  // Gallery only: a thumbnail swaps the main image (src + srcset). The page
  // is view-only — there is no pick, copy, or cart interaction here.
  for (const section of document.querySelectorAll('[data-keepsake]')) {
    if (!(section instanceof HTMLElement)) continue;
    const main = section.querySelector('[data-gallery-main]');
    for (const thumb of section.querySelectorAll('[data-gallery-thumb]')) {
      thumb.addEventListener('click', () => {
        if (!(main instanceof HTMLImageElement)) return;
        const src = thumb.getAttribute('data-src');
        const srcset = thumb.getAttribute('data-srcset') || '';
        const alt = thumb.getAttribute('data-alt') || '';
        if (src) {
          main.setAttribute('src', src);
          if (srcset) main.setAttribute('srcset', srcset);
          else main.removeAttribute('srcset');
          if (alt) main.setAttribute('alt', alt);
        }
        for (const t of section.querySelectorAll('[data-gallery-thumb]')) {
          t.setAttribute('aria-pressed', t === thumb ? 'true' : 'false');
        }
      });
    }
  }
</script>
